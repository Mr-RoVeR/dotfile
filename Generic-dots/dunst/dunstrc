[global]
    ### Placement ###
    monitor = 0
    origin = top-right
    offset = "15x15"
    width = 340
    height = 220
    gap_size = 10

    ### Layout ###
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 16
    alignment = "left"
    vertical_alignment = "center"
    ellipsize = "middle"
    word_wrap = "yes"
    ignore_newline = "no"
    shrink = "no"

    ### Icons ###
    icon_position = "left"
    min_icon_size = 40
    max_icon_size = 56
    enable_recursive_icon_lookup = true

    ### Progress bar (volume / brightness popups) ###
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    ### Look ###
    corner_radius = 14
    frame_width = 2
    frame_color = "#4d4e6b"
    separator_height = 2
    separator_color = "frame"
    font = "JetBrainsMono Nerd Font 11"
    markup = "full"

    # The closing quote on this line was missing in the original file.
    format = "<b>%s</b>\n%b"

    ### Behaviour ###
    notification_limit = 0
    idle_threshold = 120
    history_length = 20
    show_age_threshold = 60
    sort = "yes"
    indicate_hidden = "yes"
    show_indicators = "no"
    sticky_history = "yes"
    stack_duplicates = true
    hide_duplicate_count = false
    always_run_script = true
    ignore_dbusclose = false
    force_xwayland = false

    ### Mouse ###
    mouse_left_click = "do_action"
    mouse_middle_click = "close_all"
    mouse_right_click = "close_current"

[experimental]
    per_monitor_dpi = false


# ---------- Urgency levels ----------
# Colours: base #25253a, text #e2e8ff, mauve #c89bff, red #ff6e8a, overlay0 #7d80a3
# The last two hex digits of a colour are transparency (ee = ~93% opaque).

[urgency_low]
    background = "#25253aee"
    foreground = "#b8bfe0"
    frame_color = "#4d4e6b"
    highlight = "#a8b5ff"
    timeout = 4

[urgency_normal]
    background = "#25253aee"
    foreground = "#e2e8ff"
    frame_color = "#c89bff"
    highlight = "#c89bff"
    timeout = 6

[urgency_critical]
    background = "#2b1f2eee"
    foreground = "#ffd9e0"
    frame_color = "#ff6e8a"
    highlight = "#ff6e8a"
    timeout = 0
