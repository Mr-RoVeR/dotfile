* {
    font:                        "JetBrainsMono Nerd Font 12";

    base:                        #25253a;
    mantle:                      #1c1c2e;
    crust:                       #13131f;
    surface0:                    #36374f;
    surface1:                    #4d4e6b;
    overlay0:                    #7d80a3;
    text:                        #e2e8ff;
    subtext0:                    #b8bfe0;

    mauve:                       #c89bff;
    pink:                        #ff9ae0;
    red:                         #ff6e8a;
    yellow:                      #ffde67;
    green:                       #8cf0a0;
    sky:                         #6ee4f8;
    lavender:                    #a8b5ff;
}

window {
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       900px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    border:                      2px;
    border-radius:               20px;
    border-color:                @mauve;
    cursor:                      "default";
    background-color:            #1c1c2ef2;
}

mainbox {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
    orientation:                 horizontal;
    children:                    [ "imagebox", "listbox" ];
}

imagebox {
    padding:                     25px;
    background-color:            @base;
    border-radius:               18px 0px 0px 18px;
    orientation:                 vertical;
    children:                    [ "inputbar", "textbox-art", "mode-switcher" ];
}

listbox {
    spacing:                     20px;
    padding:                     20px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "message", "listview" ];
}

textbox-art {
    expand:                      true;
    padding:                     10px 0px;
    background-color:            transparent;
    text-color:                  @subtext0;
    font:                        "JetBrainsMono Nerd Font 11";
    markup:                      true;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    str:                         "<span size='57344' foreground='#c89bff'></span>&#10;&#10;<span size='13312' foreground='#e2e8ff'><b>G E N T O O</b></span>&#10;<span size='10240' foreground='#7d80a3'>Hyprland · OpenRC</span>";
}

inputbar {
    enabled:                     true;
    spacing:                     12px;
    padding:                     14px 16px;
    border-radius:               14px;
    background-color:            @surface0;
    text-color:                  @text;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "";
    background-color:            transparent;
    text-color:                  @mauve;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @text;
    cursor:                      text;
    placeholder:                 "Search";
    placeholder-color:           @overlay0;
}

mode-switcher {
    enabled:                     true;
    spacing:                     12px;
    background-color:            transparent;
    text-color:                  @text;
}

button {
    padding:                     12px;
    border-radius:               14px;
    background-color:            @surface0;
    text-color:                  @subtext0;
    horizontal-align:            0.5;
    cursor:                      pointer;
}

button selected.normal {
    background-color:            @mauve;
    text-color:                  @crust;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     8px;
    background-color:            transparent;
    text-color:                  @text;
    cursor:                      "default";
}

element {
    enabled:                     true;
    spacing:                     15px;
    padding:                     10px 12px;
    border-radius:               14px;
    background-color:            transparent;
    text-color:                  @text;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @text;
}

element normal.urgent {
    background-color:            #ff6e8a40;
    text-color:                  @red;
}

element normal.active {
    background-color:            #8cf0a033;
    text-color:                  @green;
}

element selected.normal {
    background-color:            @mauve;
    text-color:                  @crust;
}

element selected.urgent {
    background-color:            @red;
    text-color:                  @crust;
}

element selected.active {
    background-color:            @green;
    text-color:                  @crust;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        36px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

message {
    background-color:            transparent;
}

textbox {
    padding:                     14px;
    border-radius:               14px;
    background-color:            @surface0;
    text-color:                  @text;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

error-message {
    padding:                     14px;
    border:                      2px;
    border-radius:               16px;
    border-color:                @red;
    background-color:            @mantle;
    text-color:                  @text;
}
